<script defer>
  function buildRowRuler(){
    var ruler = document.getElementById('rowRuler');
    var contentCol = document.querySelector('.content-col');
    if(!ruler || !contentCol) return;
    var contentHeight = contentCol.offsetHeight;
    var rowH = 34;
    var count = Math.ceil(contentHeight / rowH);
    ruler.innerHTML = '';
    for(var i=1;i<=count;i++){
      var s = document.createElement('span');
      s.style.height = rowH+'px';
      s.style.lineHeight = rowH+'px';
      s.textContent = i;
      ruler.appendChild(s);
    }
  }
  window.addEventListener('load', buildRowRuler);
  window.addEventListener('resize', buildRowRuler);

  var tabs = document.querySelectorAll('.tab-bar a');
  var sections = Array.from(tabs).map(function(t){ return document.querySelector(t.getAttribute('href')); });
  function onScroll(){
    var pos = window.scrollY + 120;
    var current = sections[0];
    sections.forEach(function(sec){ if(sec && sec.offsetTop <= pos) current = sec; });
    if(!current) return;
    tabs.forEach(function(t){
      t.classList.toggle('active', t.getAttribute('href') === '#'+current.id);
    });
  }
  window.addEventListener('scroll', onScroll, { passive: true });
</script>
