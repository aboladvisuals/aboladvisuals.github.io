late-columns:repeat(auto-fit, minmax(240px, 1fr)); }
  .build-cell,
  .skill-cell{
    background:var(--surface);
    padding:17px 18px;
    transition:background .18s ease;
  }
  .build-cell:hover,
  .skill-cell:hover{ background:#FBFBF8; }
  .build-cell h3,
  .skill-cell h3{
    margin:0 0 8px;
    font-size:12px;
    font-family:'IBM Plex Mono', monospace;
    color:var(--ink-soft);
    font-weight:500;
    letter-spacing:0.02em;
  }
  .build-cell p{ margin:0; font-size:14.5px; color:var(--ink-soft); }
  .skill-cell p{ margin:0; font-size:14.5px; }
  .skill-note{
    margin:16px 0 0;
    font-size:13.5px;
    color:var(--ink-soft);
    max-width:70ch;
  }

  .contact-row{
    display:flex;
    gap:22px;
    flex-wrap:wrap;
    align-items:baseline;
  }
  .contact-row a{
    color:var(--blue);
    text-decoration:none;
    font-family:'IBM Plex Mono', monospace;
    font-size:14px;
    border-bottom:1px solid transparent;
    transition:border-color .15s ease;
  }
  .contact-row a:hover{ border-bottom-color:var(--blue); }

  .tab-bar{
    position:fixed;
    bottom:0; left:0; right:0;
    background:rgba(233,229,216,0.94);
    backdrop-filter:blur(10px);
    border-top:1px solid var(--rule);
    display:flex;
    justify-content:center;
    z-index:30;
    overflow-x:auto;
  }
  .tab-bar a{
    font-family:'IBM Plex Mono', monospace;
    font-size:12px;
    color:var(--ink-soft);
    text-decoration:none;
    padding:12px 13px;
    border-right:1px solid var(--rule-soft);
    white-space:nowrap;
    transition:background .15s ease, color .15s ease;
  }
  .tab-bar a:hover{ background:var(--surface); color:var(--ink); }
  .tab-bar a.active{ background:var(--surface); color:var(--blue); font-weight:600; }

  @media (max-width:640px){
    :root{ --header-w:0px; }
    .row-ruler, .col-ruler{ display:none; }
    .content-col{ padding:0 16px; }
    .hero{ padding-top:26px; padding-bottom:32px; }
    .hero .links a{ width:100%; text-align:center; }
    .project{ margin-bottom:22px; }
    .project-body{ padding:14px; }
    .project-media img{ aspect-ratio:16 / 10; }
    section, footer#contact{ padding:36px 0; }
  }

  @media (prefers-reduced-motion: reduce){
    html{ scroll-behavior:auto; }
    .hero .links a,
    .project,
    .project-media img,
    .build-cell,
    .skill-cell,
    .tab-bar a,
    .project-links a,
    .contact-row a{
      transition:none !important;
    }
    .project:hover,
    .hero .links a:hover{ transform:none; }
    .project:hover .project-media img{ transform:none; }
  }
</style>
